# ---- central API ----

# Base URL of the central API (samtek-api), for example https://central.samtek.id/api.
# Empty = the central API is not set: every call to it fails with "CENTRAL_API_URL is not set".
# Must be a full URL.
CENTRAL_API_URL=https://central.samtek.id/api

# ---- edges ----

# Timeout, in milliseconds, of each request to an edge and of each map matching request.
# Empty = 8000.
# Valid range: a whole number above 0.
EDGE_TIMEOUT_MS=8000

# ---- session ----

# 1 = the session cookie is sent only over HTTPS.
# Empty = on in a production build, off otherwise.
# Accepts 1|true|yes|on and 0|false|no|off.
# Set it to 0 when the VMS is served over plain HTTP, or the browser drops the session cookie.
COOKIE_SECURE=false

# ---- map ----

# Base URL of Valhalla (its /trace_route), used to snap the trails of the body worn cameras to roads.
# Empty = no map matching: the route answers 404 and the trails are straight lines.
# Must be a full URL.
MAP_MATCHING_URL=http://localhost:8002

# ---- mqtt in the browser (built in as a placeholder, written at install from public.env) ----

# WebSocket URL of the MQTT broker that every browser connects to, for example ws://10.0.0.5:9001.
# Empty = the browser does not use MQTT: the features that need it (edge status, ticket updates, recognition log, recording ranges) are off or use a fallback.
# Must start with ws:// or wss://. It is sent to every browser.
NEXT_PUBLIC_MQTT_WS_URL=

# Username for the MQTT broker.
# Empty = connect without a login.
# Goes together with NEXT_PUBLIC_MQTT_PASSWORD. It is sent to every browser: use an account that may only read.
NEXT_PUBLIC_MQTT_USERNAME=

# Password for the MQTT broker.
# Empty = connect without a login.
# It is sent to every browser. This file may hold credentials: do not commit it.
NEXT_PUBLIC_MQTT_PASSWORD=

# ---- camera scan (built in as a placeholder, written at install from public.env) ----

# Logins the camera scan tries, as user:password separated by commas, for example admin:admin,admin:12345.
# Empty = the scan tries no login.
# At most 8 logins. A login without a colon is a user with an empty password. It is sent to every browser.
NEXT_PUBLIC_SCAN_LOGINS=
