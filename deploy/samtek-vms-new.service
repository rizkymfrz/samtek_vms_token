# samtek-deploy: managed by deploy/deploy.sh, do not edit
[Unit]
Description=samtek_vms (web interface, behind nginx)
After=network-online.target samtek-api-new.service
Wants=network-online.target

[Service]
Type=simple
User=samtek-vms
Group=samtek-vms
EnvironmentFile=/etc/samtek/vms/vms.env
WorkingDirectory=/opt/samtek/vms/current/app
ExecStart=/opt/samtek/vms/current/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/samtek/vms
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
